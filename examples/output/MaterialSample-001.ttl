<https://www.example.com/wood3000> dcterms:title "Philip's wood sample" ;
	SIO:000008 PATO:0001736 , _:c14n0 , _:c14n1 , _:c14n2 , _:c14n3 ;
	a ENVO:00002040 , OBI:0000747 ;
	prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q4204> .
<https://www.wikidata.org/wiki/Q4204> a ENVO:01000174 , prov:Entity .
_:c14n0 dcterms:title "Volume in L" ;
